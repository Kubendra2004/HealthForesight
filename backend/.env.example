# --- CLOUD DEPLOYMENT CONFIG (Render / TiDB / Atlas) ---
# Copy this file to .env and fill in real values locally.

#MONGODB_URL="mongodb+srv://<username>:<password>@<cluster-host>/?appName=HealthForesight"
#MYSQL_URL="mysql+pymysql://<username>:<password>@<host>:<port>/<database>?ssl_ca=<CA_PATH>&ssl_verify_cert=true&ssl_verify_identity=true"

MYSQL_USER="root"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DB="health_app"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

#MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB="health_app_ai"

GEMINI_API_KEY="your-gemini-api-key"
SECRET_KEY="replace-with-a-long-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=40
